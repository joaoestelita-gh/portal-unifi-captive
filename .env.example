# ==========================================================================
# Portal Cativo - Variaveis de Ambiente (exemplo)
# Copie este arquivo para .env.local e preencha com os valores reais.
# Nao versione o .env.local com segredos reais.
# ==========================================================================

# --------------------------------------------------------------------------
# Banco de dados (PostgreSQL) - OBRIGATORIO
# String de conexao do Postgres.
#   - Local/self-hosted (sem TLS): nao inclua sslmode.
#   - Gerenciado (exige TLS): acrescente ?sslmode=require ao final.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/portal_captive"

# --------------------------------------------------------------------------
# SSL do banco - OPCIONAL
# Controla o TLS da conexao. Se nao definido, o modo e inferido do DATABASE_URL
# (usa TLS quando a URL contem sslmode=require/verify; caso contrario, sem TLS).
#   false   -> sem TLS (padrao para Postgres local)
#   require -> TLS sem validar o certificado (gerenciado/auto-assinado)
#   verify  -> TLS validando a CA
# --------------------------------------------------------------------------
DATABASE_SSL="false"

# --------------------------------------------------------------------------
# Autenticacao (Better Auth) - OBRIGATORIO
# Segredo usado para assinar sessoes e hashear a senha do admin.
# Gere um valor seguro com: openssl rand -base64 32
# --------------------------------------------------------------------------
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# --------------------------------------------------------------------------
# Usuario administrador inicial (usado pelo script scripts/create-admin.ts)
# Opcional: se nao definido, usa os valores padrao indicados abaixo.
# --------------------------------------------------------------------------
ADMIN_EMAIL="admin@portal.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# --------------------------------------------------------------------------
# Criptografia de segredos em repouso (recomendado)
# Chave usada para cifrar credenciais de controladora (senha UniFi, API key,
# client secret Aruba) gravadas no banco. Gere com: openssl rand -base64 32
# Se ausente, o sistema usa BETTER_AUTH_SECRET como fallback.
# IMPORTANTE: trocar esta chave torna ilegiveis os segredos ja gravados.
# --------------------------------------------------------------------------
SETTINGS_ENC_KEY="troque-por-um-segredo-aleatorio-de-32-bytes"

# --------------------------------------------------------------------------
# Integracao com UniFi Controller / CloudGateway (modo LOCAL)
# Opcional: necessario apenas se usar APs UniFi via login local.
# A URL deve ser acessivel a partir do servidor do portal (ex: Cloudflare Tunnel).
# Estes valores sao apenas seeds — a configuracao real vive em portal_settings.
# --------------------------------------------------------------------------
UNIFI_CONTROLLER_URL="https://192.168.1.1"
UNIFI_USERNAME="admin"
UNIFI_PASSWORD=""
UNIFI_SITE="default"

# --------------------------------------------------------------------------
# Integracao UniFi Cloud (Site Manager API + Connector Proxy)
# NAO requer variaveis de ambiente: a API key, o console e o site sao
# configurados no painel admin (aba Controladora → UniFi Cloud) e ficam
# criptografados em portal_settings. Gere a API key em:
# unifi.ui.com → Settings → API.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Integracao RADIUS (Aruba Instant On via FreeRADIUS)
# Opcional: necessario apenas se usar APs Aruba.
# Segredo compartilhado entre o FreeRADIUS (rlm_rest) e o endpoint
# /api/radius/authorize deste portal. Deve coincidir nos dois lados.
# --------------------------------------------------------------------------
RADIUS_REST_SECRET="troque-por-um-segredo-compartilhado"

# --------------------------------------------------------------------------
# Cron de limpeza de sessoes (/api/cron/sessions)
# Opcional: protege o endpoint de cron. Use o mesmo valor no agendador
# (ex: Vercel Cron) no header Authorization: Bearer <CRON_SECRET>.
# --------------------------------------------------------------------------
CRON_SECRET="troque-por-um-segredo-de-cron"
